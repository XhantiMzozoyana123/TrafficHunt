# TrafficHunt .env — copy to .env and fill in your values.
# NEVER commit the real .env (it contains secrets).

# ---------- Database ----------
# Host: "db" if using the compose mysql service, otherwise your MySQL host/IP.
DB_HOST=db
DB_PORT=3306
DB_NAME=traffichunt
DB_USER=traffichunt
DB_PASSWORD=traffichunt_secret
# Root password for the MySQL container (option A).
DB_ROOT_PASSWORD=traffichunt_root

# ---------- HTTP ----------
# Port on the HOST that maps to the app's container port 8080
# (the container runs as non-root, which cannot bind port 80).
# MUST match the port in the URL you open: http://<VPS_IP>:${PublishPort}
PublishPort=8086

# ---------- ASP.NET ----------
ASPNETCORE_ENVIRONMENT=Production
# MUST stay http://+:8080 — the runtime image runs as non-root ($APP_UID)
# and cannot bind privileged port 80. docker-compose.yml also sets this.
ASPNETCORE_URLS=http://+:8080
AutoMigrate=true
DisableHttpsRedirect=true
AllowedHosts=*

# ---------- Google OAuth (YouTube reply publishing) ----------
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=

# ---------- YouTube API key (optional comment collection) ----------
YouTube__ApiKey=

# ---------- Ollama (AI) ----------
Ollama__BaseUrl=http://46.202.170.203:11434
Ollama__Model=qwen3.5