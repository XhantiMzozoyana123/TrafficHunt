# TrafficHunt .env — copy to .env and fill in your values.
# NEVER commit the real .env (it contains secrets).

# ---------- Database ----------
# Host: "db" if using the compose mysql service, otherwise your MySQL host/IP.
DB_HOST=db
DB_PORT=3306
DB_NAME=traffichunt
DB_USER=traffichunt
DB_PASSWORD=traffichunt_secret
# Root password for the MySQL container (option A).
DB_ROOT_PASSWORD=traffichunt_root

# ---------- HTTP ----------
# Port on the host that maps to the app's port 80.
PublishPort=8080

# ---------- ASP.NET ----------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80
AutoMigrate=true
DisableHttpsRedirect=true
AllowedHosts=*

# ---------- Google OAuth (YouTube reply publishing) ----------
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=

# ---------- YouTube API key (optional comment collection) ----------
YouTube__ApiKey=

# ---------- Ollama (AI) ----------
Ollama__BaseUrl=https://llm.processzero.xyz
Ollama__Model=llama3