@model ReplyCampaignCreateViewModel
@{
    ViewData["Title"] = "New Reply Campaign";
}

<div class="page-title">New Reply Campaign</div>
<p class="page-sub">Build a rotation of AI-generated (or hand-written) reply templates, then fan them out to a campaign's qualified prospects.</p>

@if (Model.Campaigns.Count == 0)
{
    <div class="empty">You need a campaign with prospects first. <a class="link" asp-controller="Campaigns" asp-action="Index">Create a campaign</a> and run discovery.</div>
}
else
{
    <form method="post" asp-action="Create" asp-antiforgery="true">
        <div class="card">
            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="CampaignId">Source campaign *</label>
                    <select asp-for="CampaignId" asp-items="@(new SelectList(Model.Campaigns, "Id", "Name"))" required>
                        <option value="">— Select —</option>
                    </select>
                    <span class="field-hint">Prospects above the minimum intent score are queued.</span>
                </div>
                <div class="form-field">
                    <label asp-for="Name">Reply campaign name *</label>
                    <input asp-for="Name" required placeholder="e.g. Video editor outreach — Round 1" />
                </div>
                <div class="form-field">
                    <label asp-for="MinIntentScore">Min intent score</label>
                    <input asp-for="MinIntentScore" type="number" min="0" max="100" />
                </div>
                <div class="form-field">
                    <label>Delays (seconds)</label>
                    <div class="btn-row">
                        <input asp-for="MinDelaySeconds" type="number" min="0" style="width:110px" />
                        <span class="muted">to</span>
                        <input asp-for="MaxDelaySeconds" type="number" min="0" style="width:110px" />
                    </div>
                    <span class="field-hint">Random delay between replies to avoid spam patterns.</span>
                </div>
                <div class="form-field full">
                    <label asp-for="WebsiteUrl">Website URL *</label>
                    <input asp-for="WebsiteUrl" type="url" required placeholder="https://yoursite.com" />
                    <span class="field-hint">
                        The only link AI-generated replies will point to — every reply answers the prospect's
                        comment naturally, then ends with this URL to drive traffic. Templates are generated by the AI.
                    </span>
                </div>
            </div>
        </div>

        <div class="btn-row" style="margin-top:18px">
            <button class="btn" type="submit">Create reply campaign</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
}