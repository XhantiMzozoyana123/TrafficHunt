@model CampaignFormViewModel
@{
    ViewData["Title"] = "New Campaign";
}

<div class="page-title">New Campaign</div>
<p class="page-sub">Set up a campaign describing what you're promoting. Problems and keywords can also be generated by the AI planner.</p>

<form method="post" asp-action="Create" asp-antiforgery="true">
    <div class="card">
        <div class="form-grid">
            <div class="form-field">
                <label asp-for="Name">Campaign name *</label>
                <input asp-for="Name" required />
            </div>
            <div class="form-field">
                <label asp-for="Status">Status</label>
                <select asp-for="Status">
                    <option>Active</option>
                    <option>Paused</option>
                    <option>Archived</option>
                    <option>Draft</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="ProductName">Product name</label>
                <input asp-for="ProductName" />
            </div>
            <div class="form-field">
                <label asp-for="ProductUrl">Product URL</label>
                <input asp-for="ProductUrl" placeholder="https://…" />
            </div>
            <div class="form-field full">
                <label asp-for="ProductDescription">Product description</label>
                <textarea asp-for="ProductDescription"></textarea>
            </div>
            <div class="form-field full">
                <label asp-for="ValueProposition">Value proposition</label>
                <textarea asp-for="ValueProposition"></textarea>
            </div>
            <div class="form-field">
                <label asp-for="TargetAudience">Target audience</label>
                <textarea asp-for="TargetAudience"></textarea>
            </div>
            <div class="form-field">
                <label asp-for="PrimaryProblem">Primary problem solved</label>
                <textarea asp-for="PrimaryProblem"></textarea>
            </div>
            <div class="form-field full">
                <label asp-for="ProblemsText">Problems solved — one per line</label>
                <textarea asp-for="ProblemsText"></textarea>
                <span class="field-hint">Feeds the AI's qualification context.</span>
            </div>
            <div class="form-field full">
                <label asp-for="KeywordsText">Discovery keywords — one per line</label>
                <textarea asp-for="KeywordsText"></textarea>
                <span class="field-hint">YouTube searches for discovery. Try wording people actually search for.</span>
            </div>
            <div class="form-field full">
                <label asp-for="QualificationRules">Qualification rules (AI)</label>
                <textarea asp-for="QualificationRules"></textarea>
            </div>
            <div class="form-field full">
                <label asp-for="OutreachInstructions">Outreach instructions</label>
                <textarea asp-for="OutreachInstructions"></textarea>
            </div>
            <div class="form-field full">
                <label asp-for="ReplyInstructions">Reply instructions</label>
                <textarea asp-for="ReplyInstructions"></textarea>
            </div>
        </div>
    </div>

    <div class="btn-row" style="margin-top:18px">
        <button class="btn" type="submit">Create campaign</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>